{
  "manifest_version": 3,
  "name": "SelectorsBang",
  "version": "1.6.0",
  "description": "Sağ panelden bir öğe seçin; Playwright .NET seçicisini kopyalar.",
  "minimum_chrome_version": "120",
  "permissions": ["storage", "scripting", "activeTab", "clipboardWrite", "offscreen", "sidePanel", "contextMenus", "webNavigation"],
  "host_permissions": ["<all_urls>"],
  "action": {
    "default_title": "SelectorsBang",
    "default_icon": {
      "16": "icons/icon16.png",
      "32": "icons/icon32.png",
      "48": "icons/icon48.png"
    }
  },
  "side_panel": {
    "default_path": "popup.html"
  },
  "background": {
    "service_worker": "background.js"
  },
  "content_scripts": [
    {
      "matches": ["<all_urls>"],
      "js": ["lib/injected-script.js", "lib/picker-core.js", "lib/copy-feedback.js", "content/picker.js"],
      "all_frames": true,
      "match_about_blank": true,
      "run_at": "document_start"
    }
  ],
  "icons": {
    "16": "icons/icon16.png",
    "32": "icons/icon32.png",
    "48": "icons/icon48.png",
    "128": "icons/icon128.png"
  }
}
